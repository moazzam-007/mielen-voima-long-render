# Cloudflare Workers AI Accounts (3-Account Rotation)
CF_ACCOUNT_ID_1=your_cf_account_1
CF_API_TOKEN_1=your_cf_token_1

CF_ACCOUNT_ID_2=your_cf_account_2
CF_API_TOKEN_2=your_cf_token_2

CF_ACCOUNT_ID_3=your_cf_account_3
CF_API_TOKEN_3=your_cf_token_3

CF_THUMBNAIL_MODEL=@cf/black-forest-labs/flux-2-klein-9b

# LLM Providers (Google AI Studio + OpenRouter Fallback)
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite

# Security Secret
API_SECRET_KEY=your_secret_key
