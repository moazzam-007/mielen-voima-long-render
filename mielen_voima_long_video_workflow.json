    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.pollAttempts = (staticData.pollAttempts || 0) + 1;\n\nconst MAX_POLLS = 55; // 55 x 30s = ~27.5 mins buffer for 4-5 min long videos\nconst resp = $input.first().json;\n\nlet outcome;\nif (resp.status === \"completed\") {\n  outcome = \"completed\";\n} else if ([\"failed\", \"error\", \"cancelled\"].includes(resp.status)) {\n  outcome = \"failed\";\n} else if (staticData.pollAttempts >= MAX_POLLS) {\n  outcome = \"timeout\";\n} else {\n  outcome = \"retry\";\n}\n\nreturn [{\n  json: {\n    ...resp,\n    pollAttempt: staticData.pollAttempts,\n    outcome: outcome\n  }\n}];"
      },
