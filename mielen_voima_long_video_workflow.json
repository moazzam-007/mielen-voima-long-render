    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && Object.keys(r).length > 0);\nif (rows.length === 0) {\n  throw new Error(\"Mielen Voima: Koi pending long video script nahi bacha Google Sheet me!\");\n}\nconst row = rows[0]; // Take today's pending row\nconst dayLabel = row.Day || '?';\n\n// Validation: mandatory fields must exist, no silent sample defaults\nconst scriptText = String(row.Script || row.Full_Script || row.Content || '').trim();\nif (!scriptText || scriptText.length < 50) {\n  throw new Error(`Mielen Voima: Day ${dayLabel} script is missing or too short in Sheet!`);\n}\nconst title = String(row.Title || '').trim();\nif (!title) {\n  throw new Error(`Mielen Voima: Day ${dayLabel} Title is empty in Google Sheet!`);\n}\nif (title.length > 100) {\n  throw new Error(`Mielen Voima: Day ${dayLabel} Title is ${title.length} chars (YouTube max 100)!`);\n}\nconst hookTop = String(row.Hook_Top || '').trim();\nconst hookHighlight = String(row.Hook_Highlight || '').trim();\nif (!hookTop || !hookHighlight) {\n  throw new Error(`Mielen Voima: Day ${dayLabel} Hook_Top or Hook_Highlight is empty in Google Sheet!`);\n}\nconst rowId = Number(row.row_number);\nif (!Number.isInteger(rowId) || rowId < 2) {\n  throw new Error(`Mielen Voima: Missing or invalid row_number (${row.row_number}) for Sheet update!`);\n}\n\nreturn [{\n  json: {\n    day: row.Day || null,\n    title: title,\n    script: scriptText,\n    hook_top: hookTop,\n    hook_highlight: hookHighlight,\n    tags: String(row.Tags || \"älykkyys, psykologia, yliälykkyys, mielen voima, stoalaisuus, filosofia\"),\n    description: String(row.Description || \"Tilaa @Mielen_Voima saadaksesi syvällistä psykologiaa ja mielen selkeyttä viikoittain.\") + \"\\n\\n#mielenvoima #psykologia #älykkyys\",\n    sheet_row_id: rowId\n  }\n}];"
      },
